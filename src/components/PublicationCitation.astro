---
import type { CollectionEntry } from 'astro:content';
import PublicationAuthors from './PublicationAuthors.astro';
import { isPublished, isUnderReview } from '../lib/content';
interface Props { entry: CollectionEntry<'publications'>; linkAuthors?: boolean; }
const { entry, linkAuthors = true } = Astro.props;
const d = entry.data;
// 번역 금지: 논문 저자명과 학회·저널 고유명은 원문을 유지하고 심사 상태만 현지화한다.
const ko = d.language === 'ko';
const status = isUnderReview(entry) ? (ko ? '심사 중' : 'Under review') : !isPublished(entry) ? d.status : undefined;
---
<div class="publication-citation">
  {d.authors && <PublicationAuthors authors={d.authors} profiles={d.collaborators} coFirstAuthors={d.coFirstAuthors} equalContributionAuthors={d.equalContributionAuthors} lang={d.language} showLegend={false} linkProfiles={linkAuthors} />}
  {(d.venue || d.pubDate || status) && <p class="publication-venue">{d.venue && <cite>{d.venue}</cite>}{d.venue && d.pubDate && ', '}{d.pubDate && <time datetime={d.pubDate.toISOString().slice(0, 10)}>{d.pubDate.getUTCFullYear()}</time>}{status && <>{(d.venue || d.pubDate) && ' · '}<span class="publication-status">{status}</span></>}</p>}
</div>
