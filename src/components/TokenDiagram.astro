---
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<div class:list={['token-illustration', { 'token-illustration-compact': compact }]}>
  <svg viewBox="0 0 460 260" fill="none" role="img" aria-labelledby="token-title">
    <title id="token-title">Conceptual illustration of RFID food tokens communicating with a desktop reminder</title>
    <defs><pattern id="dot-grid" width="16" height="16" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".65" fill="currentColor" opacity=".14" /></pattern></defs>
    <path fill="url(#dot-grid)" d="M0 0h460v260H0z" />
    <g stroke="currentColor" stroke-width="1.5">
      <rect x="55" y="101" width="92" height="100" rx="14" fill="var(--illustration-bg)"/>
      <rect x="65" y="88" width="72" height="23" rx="7" fill="var(--illustration-bg)"/>
      <rect x="86" y="130" width="30" height="30" rx="6"/>
      <path d="M95 139h12v12H95zM91 136v18m20-18v18M95 134h12m-12 21h12" opacity=".5"/>
      <path d="M162 126q18 14 0 28m12-39q30 25 0 50" stroke-dasharray="2 5"/>
      <path d="M205 140h28" stroke-dasharray="3 5"/>
      <rect x="252" y="69" width="149" height="109" rx="9" fill="var(--illustration-bg)"/>
      <path d="M252 88h149M313 179v20m26-20v20m-44 1h62"/>
      <circle cx="264" cy="79" r="1"/><circle cx="270" cy="79" r="1"/><circle cx="276" cy="79" r="1"/>
      <rect x="267" y="104" width="24" height="23" rx="4"/><path d="M303 108h65m-65 10h40" opacity=".55"/>
      <rect x="267" y="139" width="24" height="23" rx="4"/><path d="M303 143h50m-50 10h65" opacity=".55"/>
    </g>
    <g fill="currentColor" font-family="ui-monospace, monospace" font-size="10" letter-spacing="1.2"><text x="76" y="229">RFID TOKEN</text><text x="274" y="229">STORAGE REMINDER</text></g>
  </svg>
</div>
