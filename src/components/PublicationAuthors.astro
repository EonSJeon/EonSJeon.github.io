---
import { site } from '../data/site';
import type { Locale } from '../lib/i18n';
interface Props {
  authors: string[];
  profiles: { name: string; url?: string }[];
  coFirstAuthors?: string[];
  equalContributionAuthors?: string[];
  lang?: Locale;
  showLegend?: boolean;
  linkProfiles?: boolean;
}
const { authors, profiles, coFirstAuthors = [], equalContributionAuthors = [], lang = 'en', showLegend = true, linkProfiles = true } = Astro.props;
const ko = lang === 'ko';
// 번역 금지: 저자명은 한국어 페이지에서도 영문 원문 그대로 표시한다. 기여도 안내만 현지화한다.
const otherEqualAuthors = equalContributionAuthors.filter((author) => !coFirstAuthors.includes(author));
---
<p class="publication-authors">{authors.map((author, index) => {
  const profile = linkProfiles ? profiles.find((person) => person.name === author)?.url : undefined;
  return <>{index > 0 && ', '}{author === site.name || author === site.koreanName ? <strong>{profile ? <a href={profile}>{author}</a> : author}</strong> : profile ? <a href={profile}>{author}</a> : author}{coFirstAuthors.includes(author) ? <sup aria-label={ko ? '공동 제1저자' : 'Co-first author'}>†</sup> : otherEqualAuthors.includes(author) && <sup aria-label={ko ? '동등 기여' : 'Equal contribution'}>‡</sup>}</>;
})}</p>
{showLegend && coFirstAuthors.length > 0 && <p class="publication-contribution">† {ko ? '공동 제1저자' : 'Co-first author'}</p>}
{showLegend && otherEqualAuthors.length > 0 && <p class="publication-contribution">‡ {ko ? '동등 기여' : 'Equal contribution'}</p>}
