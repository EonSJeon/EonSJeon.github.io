---
import { Image } from 'astro:assets';
import { hrefForEntry, slugForEntry, type PublicEntry } from '../lib/content';
import type { Locale } from '../lib/i18n';
interface Props { entry: PublicEntry; lang: Locale; }
const { entry, lang } = Astro.props;
const d = entry.data;
const summaries: Record<string, { title: string; context: string; en: string; ko: string }> = {
  'ee405-robotic-tic-tac-toe': { title: 'Robotic Tic-Tac-Toe', context: 'Course final project', en: 'A C++ application connects game logic, robot kinematics, and physical moves on a tic-tac-toe board.', ko: 'C++ 게임 로직과 로봇 기구학을 연결해 실제 틱택토 보드에 수를 표시하는 프로젝트입니다.' },
  'when-to-eat': { title: 'When to Eat', context: 'KAIST Makerathon', en: 'Led a four-person team building an RFID food-storage reminder. Grand Prize at the KAIST Makerathon.', ko: 'RFID 식품 보관 알림 시제품을 만든 4인 팀의 팀장을 맡았습니다. KAIST Makerathon 대상 수상작입니다.' },
  'venus-flytrap-bioelectrical-playback': { title: 'Venus Flytrap', context: 'Senior Design / Capstone', en: 'Designed the digital system: embedded firmware, MATLAB application, communication, recording, and playback.', ko: '펌웨어, MATLAB 앱, 통신, 기록과 재생을 포함한 디지털 시스템 전체를 설계·프로그래밍했습니다.' },
  'ece3011-robachtic-symphony': { title: 'RoBACHtic Symphony', context: 'Junior Design', en: 'Led mechanical design and fabrication for an educational robotic violin prototype.', ko: '교육용 로봇 바이올린 시제품의 기계 설계와 제작을 이끌었습니다.' },
};
const copy = summaries[slugForEntry(entry)];
---
<article class="home-project-row">
  <div class="home-project-body">
    {/* 번역 금지: 프로젝트 고유명과 수업 프로젝트 구분명은 양쪽에서 같은 영문 표기를 유지한다. */}
    <h3 lang="en"><a href={hrefForEntry(entry)}>{copy?.title ?? d.title}</a></h3>
    <p class="home-project-meta"><span class="home-project-period">{d.period}</span><span aria-hidden="true"> · </span><span lang="en">{copy?.context ?? d.categoryLabel}</span></p>
    <p class="home-project-summary">{copy ? copy[lang] : d.summary}</p>
  </div>
  {/* The adjacent title names this illustrative thumbnail; keep a single keyboard link per row. */}
  {d.cover && <div class="home-project-image"><Image src={d.cover.src} alt="" width={288} widths={[88, 144, 288]} sizes="(max-width: 359px) 88px, (max-width: 740px) 80px, 128px" format="webp" loading="lazy" /></div>}
</article>
