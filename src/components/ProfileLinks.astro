---
import Icon from './Icon.astro';
import { type Locale, getSiteCopy } from '../lib/i18n';
interface Props { lang?: Locale; includeEmail?: boolean; }
const { lang = 'en', includeEmail = true } = Astro.props;
const site = getSiteCopy(lang);
// 번역 금지: GitHub, Google Scholar, ORCID, LinkedIn 고유명과 이메일/URL 표기는 원문을 유지한다.
const profiles = [
  ...(includeEmail ? [{ icon: 'mail', label: site.email, href: `mailto:${site.email}` }] : []),
  { icon: 'github', label: 'github.com/EonSJeon', href: site.github },
  { icon: 'scholar', label: 'Google Scholar', href: site.scholar },
  { icon: 'orcid', label: 'ORCID', href: site.orcid },
  { icon: 'linkedin', label: 'LinkedIn', href: site.linkedin },
];
---
<ul class="profile-links" aria-label={includeEmail ? (lang === 'ko' ? '연락처와 학술 프로필' : 'Contact and academic profiles') : (lang === 'ko' ? '학술 프로필' : 'Academic profiles')}>
  {profiles.map((profile) => <li><a href={profile.href}><Icon name={profile.icon} size={19} /><span>{profile.label}</span></a></li>)}
</ul>
