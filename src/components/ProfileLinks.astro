---
import Icon from './Icon.astro';
import { type Locale, getSiteCopy } from '../lib/i18n';
interface Props { lang?: Locale; includeEmail?: boolean; iconsOnly?: boolean; copyEmail?: boolean; vertical?: boolean; includeLocation?: boolean; }
const { lang = 'en', includeEmail = true, iconsOnly = false, copyEmail = false, vertical = false, includeLocation = false } = Astro.props;
const site = getSiteCopy(lang);
const copyLabel = lang === 'ko' ? '이메일 주소 복사' : 'Copy email address';
const fallbackLabel = lang === 'ko' ? '이 주소를 직접 복사해주세요:' : 'Copy this address manually:';
// 번역 금지: 위치와 서비스 고유명, 이메일 및 URL은 양쪽 언어에서 같은 영문 값을 유지한다.
const profiles = [
  ...(includeEmail ? [{ icon: 'mail', label: vertical ? 'Email' : site.email, href: `mailto:${site.email}` }] : []),
  { icon: 'github', label: vertical ? 'GitHub' : 'github.com/EonSJeon', href: site.github },
  { icon: 'scholar', label: 'Google Scholar', href: site.scholar },
  { icon: 'orcid', label: 'ORCID', href: site.orcid },
  { icon: 'linkedin', label: 'LinkedIn', href: site.linkedin },
];
---
<ul class:list={['profile-links', { 'profile-links--icons': iconsOnly, 'profile-links--vertical': vertical }]} aria-label={includeEmail ? (lang === 'ko' ? '연락처와 학술 프로필' : 'Contact and academic profiles') : (lang === 'ko' ? '학술 프로필' : 'Academic profiles')}>
  {includeLocation && <li><a href="https://www.google.com/maps/search/?api=1&query=Atlanta%2C%20GA" target="_blank" rel="noopener noreferrer" title={lang === 'ko' ? 'Google Maps에서 Atlanta 보기' : 'View Atlanta in Google Maps'}><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></svg><span>Atlanta, GA</span></a></li>}
  {profiles.map((profile) => <li class:list={{ 'email-profile': profile.icon === 'mail' && copyEmail }}>
    {profile.icon === 'mail' && copyEmail
      ? <><div class="email-profile-row"><button type="button" data-copy-email={site.email} aria-label={`${copyLabel}: ${site.email}`} title={`${copyLabel}: ${site.email}`}><Icon name={profile.icon} size={iconsOnly ? 22 : 19} /><span class:list={{ 'sr-only': iconsOnly }}>{profile.label}</span></button><span class="email-copy-status" data-copy-status role="status" aria-live="polite" aria-atomic="true"></span></div><p class="email-copy-fallback" data-copy-fallback hidden>{fallbackLabel} <span data-email-fallback-text>{site.email}</span></p></>
      : <a href={profile.href} aria-label={iconsOnly ? profile.label : undefined} title={iconsOnly ? profile.label : undefined}><Icon name={profile.icon} size={iconsOnly ? 22 : 19} /><span class:list={{ 'sr-only': iconsOnly }}>{profile.label}</span></a>
    }
  </li>)}
</ul>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((button) => {
    const row = button.closest('.email-profile');
    const status = row?.querySelector<HTMLElement>('[data-copy-status]');
    const fallback = row?.querySelector<HTMLElement>('[data-copy-fallback]');
    let timeout: ReturnType<typeof setTimeout> | undefined;
    let attempt = 0;
    button.addEventListener('click', async () => {
      const email = button.dataset.copyEmail;
      if (!email || !status) return;
      const currentAttempt = ++attempt;
      try {
        await navigator.clipboard.writeText(email);
        if (currentAttempt !== attempt) return;
        if (timeout !== undefined) clearTimeout(timeout);
        if (fallback) fallback.hidden = true;
        // 번역 금지: 성공 피드백 Copied는 양쪽 언어에서 동일하며 1초 후 지운다.
        status.textContent = 'Copied';
        timeout = setTimeout(() => { status.textContent = ''; }, 1000);
      } catch {
        if (currentAttempt !== attempt) return;
        if (timeout !== undefined) clearTimeout(timeout);
        status.textContent = '';
        if (fallback) fallback.hidden = false;
      }
    });
  });
</script>
