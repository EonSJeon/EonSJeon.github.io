---
import Icon from './Icon.astro';
interface Props { youtubeId: string; title: string; caption?: string; }
const { youtubeId, title, caption } = Astro.props;
---
<section class="video-section" aria-label={title}>
  <h2>Demonstration</h2>
  <figure class="video-figure">
    <div class="video-container"><iframe class="video-frame" src={`https://www.youtube-nocookie.com/embed/${youtubeId}`} title={title} width="720" height="405" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>
    <figcaption>{caption && <p>{caption}</p>}<a href={`https://www.youtube.com/watch?v=${youtubeId}`}>Watch on YouTube<Icon name="arrow-up-right" size={13} /></a></figcaption>
  </figure>
</section>
