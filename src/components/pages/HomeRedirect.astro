---
import { getSiteCopy, localizePath, type Locale } from '../../lib/i18n';
interface Props { lang?: Locale; }
const { lang = 'en' } = Astro.props;
const site = getSiteCopy(lang);
const home = localizePath('/', lang);
const title = lang === 'ko' ? '홈으로 이동' : 'Continue to home';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(home, Astro.site)} />
    <title>{title} — {site.name}</title>
    <script is:inline define:vars={{ home }}>
      window.location.replace(home + window.location.search + window.location.hash);
    </script>
    <meta http-equiv="refresh" content={`0;url=${home}`} />
  </head>
  <body>
    <p><a href={home}>{title}</a></p>
  </body>
</html>
