---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
import WorkCard from '../WorkCard.astro';
import TokenDiagram from '../TokenDiagram.astro';
import ProfileLinks from '../ProfileLinks.astro';
import { Image } from 'astro:assets';
import { type Locale, localizePath, getSiteCopy } from '../../lib/i18n';
import { getPublicEntries, hrefForEntry } from '../../lib/content';
interface Props { lang?: Locale; }
const { lang = 'en' } = Astro.props;
const ko = lang === 'ko';
const site = getSiteCopy(lang);
const [research, projects, coursework, writing] = await Promise.all([
  getPublicEntries('research', lang), getPublicEntries('projects', lang), getPublicEntries('coursework', lang), getPublicEntries('blog', lang),
]);
const selectedResearch = research.filter((entry) => entry.data.featured).slice(0, 2);
const selectedCoursework = coursework.filter((entry) => entry.data.featured).slice(0, 2);
const project = projects.find((entry) => entry.data.featured);
const c = ko ? {
  eyebrow: 'Georgia Tech · Electrical & Computer Engineering', role: '박사과정 · Atlanta, Georgia',
  intro: '무선 통신 시스템의 동기화와 통계적 신호 추정을 연구합니다. Georgia Institute of Technology 전기컴퓨터공학 박사과정에 재학 중이며, 지도교수는 ', advisorEnd: ' 교수님입니다.',
  about: '자세한 소개', institution: 'Georgia Institute of Technology', interests: '연구 관심 분야',
  research: '주요 연구', researchLabel: '무선 통신과 신호 처리', allResearch: '전체 연구',
  independent: '독립 프로젝트', outside: '연구실 밖에서', allProjects: '전체 프로젝트',
  award: '2024 KAIST Makerathon · 대상', projectSubtitle: 'RFID 식품 보관 알림 장치',
  projectDescription: '재사용할 수 있는 RFID 토큰을 데스크톱 인터페이스와 연결한 식품 보관 알림 장치입니다. 일상 속 물리적 상호작용을 바탕으로 팀이 함께 제작한 시제품입니다.',
  explore: '프로젝트 보기', coursework: '만들며 배우기', selectedCoursework: '주요 수업 프로젝트', allCoursework: '전체 수업 프로젝트',
  writing: '글', allWriting: '전체 글',
  recent: '최근 글', contact: '연구나 프로젝트에 관심이 있으신가요?', getInTouch: '연락하기',
} : {
  eyebrow: 'Georgia Tech · Electrical & Computer Engineering', role: 'Ph.D. student · Atlanta, Georgia',
  intro: 'I study synchronization and statistical signal estimation for wireless communication systems. I am a Ph.D. student at Georgia Tech, advised by ', advisorEnd: '.',
  about: 'More about me', institution: 'Georgia Institute of Technology', interests: 'Research interests',
  research: 'Selected research', researchLabel: 'Wireless communications & signal processing', allResearch: 'All research',
  independent: 'Independent engineering', outside: 'Outside the lab', allProjects: 'All projects',
  award: '2024 KAIST Makerathon · Grand Prize', projectSubtitle: 'RFID Food Storage Reminder',
  projectDescription: 'A food-storage reminder that connects reusable RFID tokens with a desktop interface. A team-built prototype, designed around everyday physical interactions.',
  explore: 'Explore the project', coursework: 'Learning through making', selectedCoursework: 'Selected coursework', allCoursework: 'All coursework',
  writing: 'Writing', allWriting: 'All writing',
  recent: 'Recent writing', contact: 'Interested in my research or engineering work?', getInTouch: 'Get in touch',
};
---
<SiteLayout lang={lang}>
  <section class="hero" aria-labelledby="intro-title">
    <div class="hero-text">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1 id="intro-title">{ko ? site.koreanName : 'Sangeon Jeon'}<span class="hero-korean" lang={ko ? 'en' : 'ko'}>{ko ? 'Sangeon Jeon' : site.koreanName}</span><span class="hero-hanja" lang="zh-Hant">{site.hanjaName}</span></h1>
      <p class="hero-role">{c.role}</p>
      <p class="hero-description">{c.intro}<a href={site.advisor.url}>Xiaoli Ma</a>{c.advisorEnd}</p>
      <ProfileLinks lang={lang} />
      <a class="text-link hero-about" href={localizePath('/about/', lang)}>{c.about}<Icon name="arrow-right" size={16} /></a>
    </div>
    <figure class="hero-portrait"><div class="portrait-frame"><img src="/images/sangeon-jeon.jpeg" alt={ko ? '전상언' : 'Sangeon Jeon'} width="246" height="246" fetchpriority="high" /></div><figcaption>{c.institution}</figcaption></figure>
  </section>
  <div class="interest-line"><span>{c.interests}</span><ul>{site.interests.map((interest) => <li>{interest}</li>)}</ul></div>
  <section class="home-section" aria-labelledby="research-heading">
    <SectionHeading title={c.research} label={c.researchLabel} href={localizePath('/research/', lang)} linkText={c.allResearch} id="research-heading" />
    <div class="work-grid">{selectedResearch.map((entry) => <WorkCard entry={entry} lang={lang} />)}</div>
  </section>
  {project && <section class="home-section" aria-label={c.independent}>
    <SectionHeading title={c.outside} label={c.independent} href={localizePath('/projects/', lang)} linkText={c.allProjects} />
    <article class="project-feature">
      {project.data.cover ? <div class="feature-image"><Image src={project.data.cover.src} alt={project.data.cover.alt} width={1000} widths={[480, 720, 1000]} sizes="(max-width: 740px) calc(100vw - 40px), 480px" format="webp" loading="lazy" /></div> : <TokenDiagram compact lang={lang} />}
      <div class="feature-copy"><p class="eyebrow">{c.award}</p><h3>When to Eat</h3><p class="feature-subtitle">{c.projectSubtitle}</p><p class="feature-description">{c.projectDescription}</p><a class="text-link" href={hrefForEntry(project)}>{c.explore}<Icon name="arrow-right" size={17} /></a></div>
    </article>
  </section>}
  <section class="home-section" aria-label={c.selectedCoursework}>
    <SectionHeading title={c.coursework} label={c.selectedCoursework} href={localizePath('/coursework/', lang)} linkText={c.allCoursework} />
    <div class="work-grid">{selectedCoursework.map((entry) => <WorkCard entry={entry} compact lang={lang} />)}</div>
  </section>
  {writing.length > 0 && <section class="home-section" aria-label={c.recent}>
    <SectionHeading title={c.writing} href={localizePath('/blog/', lang)} linkText={c.allWriting} />
    <div class="editorial-list">{writing.slice(0, 3).map((entry) => <article class="editorial-entry"><p class="eyebrow">{entry.data.categoryLabel}</p><h3><a href={hrefForEntry(entry)}>{entry.data.title}</a></h3><p>{entry.data.summary}</p></article>)}</div>
  </section>}
  <div class="home-contact"><p>{c.contact}</p><a class="text-link" href={localizePath('/about/#contact', lang)}>{c.getInTouch}<Icon name="arrow-right" size={16} /></a></div>
</SiteLayout>
