---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SectionHeading from '../SectionHeading.astro';
import NewsList from '../NewsList.astro';
import ProfileLinks from '../ProfileLinks.astro';
import { type Locale, getSiteCopy, localizePath } from '../../lib/i18n';
interface Props { lang?: Locale; }
const { lang = 'en' } = Astro.props;
const ko = lang === 'ko';
const site = getSiteCopy(lang);
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${site.mapPlaceName}, ${site.mapAddress}`)}`;
// 번역 금지: 학교 고유명(Georgia Tech / Georgia Institute of Technology), 기관 표기의
// Electrical & Computer Engineering, Atlanta, Georgia는 영어를 유지한다. 주변 소개 문장은 번역한다.
// 번역 금지: 한·영 모두 Prof.와 영문 성명을 하나의 링크로 표시하고, 학위 프로그램의 전체 영문 명칭을 유지한다.
const advisorLabel = `Prof. ${site.advisor.name}`;
const kaistAdvisorLabel = `Prof. ${site.kaistAdvisor.name}`;
const dualDegreeProgramLabel = 'KAIST–Georgia Tech Dual B.S. Degree Program';
const c = ko ? {
  role: '박사과정 · Atlanta, Georgia',
  intro: '제 웹사이트에 오신 것을 환영합니다! Georgia Institute of Technology 전기컴퓨터공학 박사과정에 재학 중이며, 지도교수는 ',
  introAfterAdvisor: '입니다.',
  research: '현재는 무선통신을 위한 차세대 파형의 설계와 동기화를 연구하며, 특히 OCDM(orthogonal chirp division multiplexing)에 집중하고 있습니다. TI-ADC 불일치 보정, 베이지안 통계에 관련한 연구 경험도 있습니다.',
  mastersBeforeAdvisor: '이전에는 Georgia Institute of Technology에서 ',
  mastersAfterAdvisor: '의 지도로 전기컴퓨터공학 석사학위를 취득했습니다(2025).',
  dualBefore: '학부에서는 ',
  dualAfter: '을 이수하여 KAIST와 Georgia Institute of Technology에서 각각 학사학위를 취득했습니다.',
  kaistBefore: ' KAIST 학부과정의 지도교수는 ', kaistAfterName: '이었습니다.',
  cvBefore: '더 자세한 내용은 ', cvAfter: '를 참고해주세요.',
  interests: '연구 관심 분야',
  contact: '연락처', maps: 'Google Maps에서 주소 보기',
  success: '이메일 주소를 복사했습니다.', fallback: '선택된 이메일 주소를 직접 복사해주세요.',
} : {
  role: 'Ph.D. student · Atlanta, Georgia',
  intro: 'Welcome to my website! I am a Ph.D. student in Electrical and Computer Engineering at Georgia Institute of Technology, advised by ',
  introAfterAdvisor: '.',
  research: 'My current research focuses on the design and synchronization of next-generation waveforms for wireless communications, especially orthogonal chirp division multiplexing (OCDM). I also have research experience in TI-ADC mismatch calibration, and Bayesian statistics.',
  mastersBeforeAdvisor: 'Previously, I received my M.S. in Electrical and Computer Engineering from Georgia Tech in 2025, advised by ',
  mastersAfterAdvisor: '.',
  dualBefore: "I earned my bachelor's degrees from KAIST and Georgia Institute of Technology through the ",
  dualAfter: '.',
  kaistBefore: ' My undergraduate advisor at KAIST was ', kaistAfterName: '.',
  cvBefore: 'For further information, please refer to my ', cvAfter: '.',
  interests: 'Research interests',
  contact: 'Contact', maps: 'View address in Google Maps',
  success: 'Email address copied.', fallback: 'Copy the selected email address manually.',
};
---
<SiteLayout lang={lang}>
  <section class="hero" aria-labelledby="intro-title">
    <header class="hero-heading">
      <h1 id="intro-title">{ko ? site.koreanName : 'Sangeon Jeon'}<span class="hero-korean" lang={ko ? 'en' : 'ko'}>{ko ? 'Sangeon Jeon' : site.koreanName}</span><span class="hero-hanja" lang="zh-Hant">{site.hanjaName}</span></h1>
      <p class="hero-role">{c.role}</p>
    </header>
    <div class="hero-description">
      <p>{c.intro}<a class="hero-advisor" href={site.advisor.url} lang="en">{advisorLabel}</a>{c.introAfterAdvisor}</p>
      <p>{c.research}</p>
      <p>{c.mastersBeforeAdvisor}<a class="hero-advisor" href={site.advisor.url} lang="en">{advisorLabel}</a>{c.mastersAfterAdvisor}{' '}{c.dualBefore}<a href={site.dualDegreeProgram[lang]} lang="en">{dualDegreeProgramLabel}</a>{c.dualAfter}{c.kaistBefore}<a class="hero-advisor" href={site.kaistAdvisor.url} lang="en">{kaistAdvisorLabel}</a>{c.kaistAfterName}</p>
      {/* 번역 금지: Curriculum Vitae 링크 문구는 고정하고, 앞뒤 안내 문장만 현지화한다. */}
      <p>{c.cvBefore}<a class="hero-cv" href={localizePath('/cv/', lang)}>Curriculum Vitae</a>{c.cvAfter}</p>
    </div>
    <div class="hero-aside">
      <figure class="hero-portrait"><div class="portrait-frame"><img src="/images/sangeon-jeon.jpeg" alt='Sangeon Jeon' width="246" height="246" fetchpriority="high" /></div></figure>
      <section class="portrait-contact" id="contact" aria-label={c.contact} data-copy-success={c.success} data-copy-fallback={c.fallback}>
        <address class="contact-address"><span class="contact-building">{site.address}</span><a class="contact-map" href={mapsUrl} target="_blank" rel="noopener noreferrer" aria-label={`${c.maps}: ${site.mapAddress}`} title={c.maps}>{site.mapAddress}</a></address>
        <ProfileLinks lang={lang} iconsOnly copyEmail />
        <p class="copy-status" role="status" aria-live="polite"></p>
      </section>
    </div>
  </section>
  <div class="interest-line"><span>{c.interests}</span><ul>{site.interests.map((interest) => <li>{interest}</li>)}</ul></div>
  <section class="home-section" aria-labelledby="news-heading">
    <SectionHeading title="News" id="news-heading" />
    <NewsList lang={lang} />
  </section>
</SiteLayout>
<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const contact = copyButton?.closest<HTMLElement>('.portrait-contact');
  const copyStatus = document.querySelector<HTMLElement>('.copy-status');
  let feedbackTimeout: ReturnType<typeof setTimeout> | undefined;
  const showCopyFeedback = (message: string, email?: string) => {
    if (!copyStatus) return;
    if (feedbackTimeout !== undefined) clearTimeout(feedbackTimeout);
    copyStatus.textContent = message;
    if (email) {
      const address = document.createElement('span');
      address.textContent = email;
      address.dataset.emailFallback = '';
      copyStatus.append(' ', address);
      const range = document.createRange();
      range.selectNodeContents(address);
      const selection = window.getSelection();
      selection?.removeAllRanges();
      selection?.addRange(range);
    }
    feedbackTimeout = setTimeout(() => {
      copyStatus.textContent = '';
      feedbackTimeout = undefined;
    }, 3000);
  };
  copyButton?.addEventListener('click', async () => {
    const email = copyButton.dataset.copyEmail;
    if (!email || !copyStatus) return;
    try {
      await navigator.clipboard.writeText(email);
      showCopyFeedback(contact?.dataset.copySuccess ?? '');
    } catch {
      showCopyFeedback(contact?.dataset.copyFallback ?? '', email);
    }
  });
</script>
