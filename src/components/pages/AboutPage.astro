---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeader from '../PageHeader.astro';
import Icon from '../Icon.astro';
import ProfileLinks from '../ProfileLinks.astro';
import { type Locale, localizePath, getSiteCopy, getEducationCopy } from '../../lib/i18n';
interface Props { lang?: Locale; }
const { lang = 'en' } = Astro.props;
const ko = lang === 'ko';
const site = getSiteCopy(lang);
const education = getEducationCopy(lang);
const c = ko ? {
  title: '소개', description: '조지아공과대학교 전기컴퓨터공학 박사과정 전상언의 소개입니다.', heading: '소개',
  intro: '조지아공과대학교 전기컴퓨터공학 박사과정에 재학 중이며, 지도교수는 ', advisorEnd: ' 교수님입니다.',
  research: '무선 통신 시스템의 동기화와 통계적 신호 추정을 연구합니다. 현재는 처프 기반 다중반송파 파형의 주파수 오프셋 추정과 OFDM 수신기의 채널·하드웨어 불일치 공동 추정에 관심을 두고 있습니다.',
  engineering: '연구와 함께 수학적 모델, 소프트웨어, 물리적 하드웨어를 연결하는 시스템을 만드는 일을 즐깁니다. RFID 알림 장치부터 생체전기 신호 기록과 메카트로닉스 시제품까지 다양한 프로젝트를 진행했습니다.',
  education: '학력', gpa: '학점', interests: '연구 관심 분야', contact: '연락처',
  contactStart: '미국 조지아주 애틀랜타에 거주하고 있습니다. 연구나 프로젝트에 관한 문의는 ', contactEnd: '으로 보내주세요.',
  write: '이메일 보내기', copy: '이메일 주소 복사', cv: 'CV와 이력서',
  success: '이메일 주소를 복사했습니다.', fallback: '위 이메일 주소를 선택하여 복사해주세요.',
  institution: '조지아공과대학교', department: '전기컴퓨터공학', location: '미국 조지아주 애틀랜타',
} : {
  title: 'About', description: 'About Sangeon Jeon, a Ph.D. student in Electrical and Computer Engineering at Georgia Tech.', heading: 'About me',
  intro: 'I am a Ph.D. student in Electrical and Computer Engineering at the Georgia Institute of Technology, advised by ', advisorEnd: '.',
  research: 'My research focuses on synchronization and statistical signal estimation for wireless communication systems. My current work considers frequency-offset estimation for chirp-based multicarrier waveforms and joint channel and hardware-impairment estimation in OFDM receivers.',
  engineering: 'Alongside research, I enjoy building systems that connect mathematical models, software, and physical hardware. My engineering work has ranged from RFID-based reminders to bioelectrical recording and mechatronic prototypes.',
  education: 'Education', gpa: 'GPA', interests: 'Research interests', contact: 'Contact',
  contactStart: 'I am based in Atlanta, Georgia. For questions about my research or projects, email ', contactEnd: '.',
  write: 'Write an email', copy: 'Copy email', cv: 'CV & resume',
  success: 'Email address copied.', fallback: 'Select and copy the email address above.',
  institution: 'Georgia Institute of Technology', department: 'Electrical & Computer Engineering', location: 'Atlanta, Georgia',
};
---
<SiteLayout title={c.title} description={c.description} lang={lang}>
  <PageHeader title={c.heading} eyebrow={ko ? '전상언 · Sangeon Jeon' : 'Sangeon Jeon · 전상언'} />
  <div class="about-grid">
    <div>
      <div class="prose">
        <p>{c.intro}<a href={site.advisor.url}>Xiaoli Ma</a>{c.advisorEnd}</p>
        <p>{c.research}</p>
        <p>{c.engineering}</p>
      </div>
      <section class="about-section" aria-labelledby="education-heading"><h2 id="education-heading">{c.education}</h2><ul class="education-list">{education.map((item) => <li><div><strong>{item.degree}</strong><p>{item.institution}</p><p>{c.gpa}: {item.gpa}</p>{item.note && <p>{item.note}</p>}</div><time>{item.period}</time></li>)}</ul></section>
      <section class="about-section" aria-labelledby="interests-heading"><h2 id="interests-heading">{c.interests}</h2><ul class="tags">{site.interests.map((interest) => <li>{interest}</li>)}</ul></section>
      <section class="about-section" id="contact" aria-labelledby="contact-heading">
        <h2 id="contact-heading">{c.contact}</h2>
        <div class="prose"><p>{c.contactStart}<a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a>{c.contactEnd}</p></div>
        <div class="contact-actions"><a class="button" href={`mailto:${site.email}`}><Icon name="mail" size={17} />{c.write}</a><button class="button" type="button" data-copy-email={site.email} data-copy-success={c.success} data-copy-fallback={c.fallback}><Icon name="copy" size={17} />{c.copy}</button><a class="text-link" href={localizePath('/cv/', lang)}>{c.cv}<Icon name="arrow-right" size={16} /></a></div>
        <p class="copy-status" role="status" aria-live="polite"></p>
        <ProfileLinks lang={lang} />
      </section>
    </div>
    <aside class="about-aside"><div class="about-photo"><img src="/images/sangeon-jeon.jpeg" alt={ko ? '전상언' : 'Sangeon Jeon'} width="246" height="246" /></div><p class="about-caption">{c.institution}<br />{c.department}<br />{c.location}</p></aside>
  </div>
</SiteLayout>
<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const copyStatus = document.querySelector<HTMLElement>('.copy-status');
  copyButton?.addEventListener('click', async () => {
    const email = copyButton.dataset.copyEmail;
    if (!email || !copyStatus) return;
    try {
      await navigator.clipboard.writeText(email);
      copyStatus.textContent = copyButton.dataset.copySuccess ?? '';
    } catch {
      const address = document.querySelector('.contact-email');
      if (address) {
        const range = document.createRange();
        range.selectNodeContents(address);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
      copyStatus.textContent = copyButton.dataset.copyFallback ?? '';
    }
  });
</script>
