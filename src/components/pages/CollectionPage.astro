---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeader from '../PageHeader.astro';
import WorkCard from '../WorkCard.astro';
import Icon from '../Icon.astro';
import PublicationList from '../PublicationList.astro';
import CourseworkList from '../CourseworkList.astro';
import { getSectionsCopy, localizePath, formatDate, type Locale } from '../../lib/i18n';
import { hrefForEntry, type PublicCollection, type PublicEntry } from '../../lib/content';
interface Props { collection: PublicCollection; entries: PublicEntry[]; lang?: Locale; }
const { collection, entries, lang = 'en' } = Astro.props;
const ko = lang === 'ko';
const copy = getSectionsCopy(lang)[collection];
const editorial = collection === 'blog' || collection === 'proposals';
---
<SiteLayout title={copy.label} description={copy.description} lang={lang}>
  <PageHeader title={copy.label} eyebrow={copy.eyebrow} description={copy.description} />
  {collection === 'proposals' && entries.length > 0 && <p class="proposal-intro">{ko ? '초기 구상 단계의 아이디어입니다. 가능한 접근 방법과 첫 실험을 제안하며, 실현 가능성과 독창성은 앞으로 검증할 과제입니다.' : 'Early-stage ideas with proposed approaches and first experiments. Feasibility and novelty remain open questions.'}</p>}
  {collection === 'publications' ? <PublicationList entries={entries.filter((entry) => entry.collection === 'publications')} lang={lang} /> : collection === 'coursework' ? <CourseworkList entries={entries} lang={lang} /> : editorial ? <>
    {entries.length > 0 ? <div class="editorial-list">{entries.map((entry) => <article class="editorial-entry">{collection === 'proposals' && <div class="editorial-meta"><span>{entry.data.categoryLabel}</span><span class="status">{entry.data.status}</span></div>}{entry.data.pubDate && <time datetime={entry.data.pubDate.toISOString()}>{formatDate(entry.data.pubDate, lang)}</time>}<h2><a href={hrefForEntry(entry)}>{entry.data.title}</a></h2><p>{entry.data.summary}</p><a class="text-link" href={hrefForEntry(entry)}>{collection === 'proposals' ? (ko ? '아이디어 살펴보기' : 'Explore the concept') : (ko ? '계속 읽기' : 'Read more')}<Icon name="arrow-right" size={16} /></a></article>)}</div> : <div class="empty-state"><span class="empty-symbol"><Icon name={collection === 'blog' ? 'book' : 'arrow-up-right'} size={21} /></span><h2>{collection === 'blog' ? (ko ? '차근차근 기록해 나갈 공간입니다.' : 'Notes are on the way.') : (ko ? '다음 질문을 위한 공간입니다.' : 'A place for the next question.')}</h2><p>{collection === 'blog' ? (ko ? '기술 노트와 긴 생각이 정리되는 대로 이곳에 올리겠습니다.' : 'I’ll share technical notes and longer reflections here as they take shape.') : (ko ? '정리된 프로젝트 아이디어와 연구 질문을 이곳에서 소개하겠습니다.' : 'Selected project ideas and research questions will appear here as they are ready to share.')}</p><a class="text-link" href={localizePath('/publications/', lang)}>{ko ? '논문 목록 보기' : 'View publications'}<Icon name="arrow-right" size={16} /></a></div>}
  </> : <div class="work-grid">{entries.map((entry) => <WorkCard entry={entry} lang={lang} />)}</div>}
</SiteLayout>
