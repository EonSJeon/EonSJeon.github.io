---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeader from '../PageHeader.astro';
import WorkCard from '../WorkCard.astro';
import Icon from '../Icon.astro';
import { getSectionsCopy, localizePath, formatDate, type Locale } from '../../lib/i18n';
import { getPublicEntries, hrefForEntry, slugForEntry, isPublished, isUnderReview, type PublicCollection, type PublicEntry } from '../../lib/content';
interface Props { collection: PublicCollection; entries: PublicEntry[]; lang?: Locale; }
const { collection, entries, lang = 'en' } = Astro.props;
const ko = lang === 'ko';
const copy = getSectionsCopy(lang)[collection];
const editorial = collection === 'blog' || collection === 'proposals';
const published = entries.filter(isPublished);
const submitted = entries.filter(isUnderReview);
const otherManuscripts = entries.filter((entry) => !published.includes(entry) && !submitted.includes(entry));
const linkedResearch = new Set(submitted.map((entry) => entry.data.relatedResearch).filter(Boolean));
const underReview = collection === 'publications' ? (await getPublicEntries('research', lang)).filter((entry) => isUnderReview(entry) && !linkedResearch.has(slugForEntry(entry))) : [];
const researchGroups = [
  { key: 'communications', title: ko ? '무선통신과 신호처리' : 'Wireless communications & signal processing', description: ko ? '동기화와 수신기 추정을 위한 모델 기반 연구입니다.' : 'Model-based research on synchronization and receiver estimation.', entries: entries.filter((entry) => entry.collection === 'research' && entry.data.researchArea !== 'meta-analysis') },
  { key: 'meta-analysis', title: 'Meta Analysis', description: ko ? '질환별 유병률 자료를 종합하고 인구 구조와 자원 격차를 탐구합니다.' : 'Synthesizing disease-prevalence evidence and examining population structure and resource gaps.', entries: entries.filter((entry) => entry.collection === 'research' && entry.data.researchArea === 'meta-analysis') },
];
---
<SiteLayout title={copy.label} description={copy.description} lang={lang}>
  <PageHeader title={copy.label} eyebrow={copy.eyebrow} description={copy.description} />
  {collection === 'proposals' && entries.length > 0 && <p class="proposal-intro">{ko ? '초기 구상 단계의 아이디어입니다. 가능한 접근 방법과 첫 실험을 제안하며, 실현 가능성과 독창성은 앞으로 검증할 과제입니다.' : 'Early-stage ideas with proposed approaches and first experiments. Feasibility and novelty remain open questions.'}</p>}
  {collection === 'research' ? <>
    <nav class="research-jump-links" aria-label={ko ? '연구 분야' : 'Research areas'}>{researchGroups.filter((group) => group.entries.length > 0).map((group) => <a href={`#${group.key}`}>{group.title}<Icon name="arrow-right" size={14} /></a>)}</nav>
    {researchGroups.filter((group) => group.entries.length > 0).map((group) => <section class="research-group" id={group.key} aria-labelledby={`${group.key}-heading`}><h2 id={`${group.key}-heading`}>{group.title}</h2><p class="research-group-intro">{group.description}</p><div class="work-grid">{group.entries.map((entry) => <WorkCard entry={entry} lang={lang} />)}</div></section>)}
  </> : collection === 'publications' ? <>
    {published.length > 0 && <section aria-label={ko ? '게재 및 게재 승인 논문' : 'Published and accepted work'}><h2 class="publication-heading">{ko ? '게재 및 게재 승인' : 'Published & accepted'}</h2>{published.map((entry) => <article class="publication-entry"><h2><a href={hrefForEntry(entry)}>{entry.data.title}</a></h2>{entry.data.authors && <p>{entry.data.authors.join(', ')}</p>}<p>{entry.data.venue}</p><span class="status">{entry.data.status}</span></article>)}</section>}
    {(underReview.length > 0 || submitted.length > 0) && <section aria-label={ko ? '심사 중인 논문' : 'Manuscripts under review'}><h2 class="publication-heading">{ko ? '심사 중' : 'Under review'}</h2>{[...submitted, ...underReview].map((entry) => <article class="publication-entry"><h2><a href={hrefForEntry(entry)}>{entry.data.title}</a></h2><p>{entry.data.summary}</p><p><span class="status status-review">{entry.data.status}</span></p><a class="text-link" href={hrefForEntry(entry)}>{ko ? '연구 소개' : 'Research overview'}<Icon name="arrow-right" size={16} /></a></article>)}</section>}
    {otherManuscripts.length > 0 && <section class="page-section" aria-label={ko ? '그 밖의 원고' : 'Other manuscripts'}><h2 class="publication-heading">{ko ? '그 밖의 원고' : 'Other manuscripts'}</h2>{otherManuscripts.map((entry) => <article class="publication-entry"><h2><a href={hrefForEntry(entry)}>{entry.data.title}</a></h2><p>{entry.data.summary}</p><span class="status">{entry.data.status}</span></article>)}</section>}
    <p class="page-note">{ko ? <>원고 작성 중인 연구는 <a href={localizePath('/research/', lang)}>연구 페이지</a>에서 소개합니다.</> : <>Research projects with manuscripts in preparation are listed on the <a href="/research/">Research page</a>.</>}</p>
  </> : editorial ? <>
    {entries.length > 0 ? <div class="editorial-list">{entries.map((entry) => <article class="editorial-entry">{collection === 'proposals' && <div class="editorial-meta"><span>{entry.data.categoryLabel}</span><span class="status">{entry.data.status}</span></div>}{entry.data.pubDate && <time datetime={entry.data.pubDate.toISOString()}>{formatDate(entry.data.pubDate, lang)}</time>}<h2><a href={hrefForEntry(entry)}>{entry.data.title}</a></h2><p>{entry.data.summary}</p><a class="text-link" href={hrefForEntry(entry)}>{collection === 'proposals' ? (ko ? '아이디어 살펴보기' : 'Explore the concept') : (ko ? '계속 읽기' : 'Read more')}<Icon name="arrow-right" size={16} /></a></article>)}</div> : <div class="empty-state"><span class="empty-symbol"><Icon name={collection === 'blog' ? 'book' : 'arrow-up-right'} size={21} /></span><h2>{collection === 'blog' ? (ko ? '차근차근 기록해 나갈 공간입니다.' : 'Notes are on the way.') : (ko ? '다음 질문을 위한 공간입니다.' : 'A place for the next question.')}</h2><p>{collection === 'blog' ? (ko ? '기술 노트와 긴 생각이 정리되는 대로 이곳에 올리겠습니다.' : 'I’ll share technical notes and longer reflections here as they take shape.') : (ko ? '정리된 프로젝트 아이디어와 연구 질문을 이곳에서 소개하겠습니다.' : 'Selected project ideas and research questions will appear here as they are ready to share.')}</p><a class="text-link" href={localizePath('/research/', lang)}>{ko ? '현재 연구 살펴보기' : 'Explore my current research'}<Icon name="arrow-right" size={16} /></a></div>}
  </> : <div class="work-grid">{entries.map((entry) => <WorkCard entry={entry} lang={lang} />)}</div>}
</SiteLayout>
