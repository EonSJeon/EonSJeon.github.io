---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeader from '../PageHeader.astro';
import Icon from '../Icon.astro';
import CourseworkList from '../CourseworkList.astro';
import VisibilityBadge from '../VisibilityBadge.astro';
import { getSectionsCopy, formatDate, type Locale } from '../../lib/i18n';
import { editorialTags, hrefForEntry, type PublicEntry } from '../../lib/content';
interface Props { collection: 'coursework' | 'blog'; entries: PublicEntry[]; lang?: Locale; }
const { collection, entries, lang = 'en' } = Astro.props;
const ko = lang === 'ko';
const copy = getSectionsCopy(lang)[collection];
---
<SiteLayout title={copy.label} description={copy.description} lang={lang}>
  <PageHeader title={copy.label} description={copy.description} />
  {collection === 'coursework' ? <CourseworkList entries={entries} lang={lang} /> : entries.length > 0 ? <div class="editorial-list">{entries.map((entry) => <article class="editorial-entry"><VisibilityBadge entry={entry} />{entry.collection === 'proposals' && <div class="editorial-meta"><span class="status">{ko ? '아이디어 · 구상 단계' : 'Idea · Draft concept'}</span></div>}{entry.data.pubDate && <time datetime={entry.data.pubDate.toISOString()}>{formatDate(entry.data.pubDate, lang)}</time>}<h2><a href={hrefForEntry(entry)}>{entry.data.title}</a></h2><p>{entry.data.summary}</p>{editorialTags(entry).length > 0 && <ul class="tags">{editorialTags(entry).map((tag) => <li>#{tag}</li>)}</ul>}<a class="text-link" href={hrefForEntry(entry)}>{ko ? '계속 읽기' : 'Read more'}<Icon name="arrow-right" size={16} /></a></article>)}</div> : <div class="empty-state"><span class="empty-symbol"><Icon name="book" size={21} /></span><h2>{ko ? '글을 준비하고 있습니다.' : 'Notes are on the way.'}</h2><p>{ko ? '정리된 글과 아이디어를 이곳에 올리겠습니다.' : 'Technical notes and ideas will appear here as they are ready.'}</p></div>}
</SiteLayout>
