---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeader from '../PageHeader.astro';
import Icon from '../Icon.astro';
import { type Locale, localizePath } from '../../lib/i18n';
import { statSync } from 'node:fs';
import path from 'node:path';
import downloads from '../../documents/downloads.json';
interface Props { lang?: Locale; }
const { lang = 'en' } = Astro.props;
const ko = lang === 'ko';
const shortDocument = downloads.find((document) => document.id === 'industrial')!;
const fullDocument = downloads.find((document) => document.id === 'full')!;
const sizeKB = (document: typeof shortDocument) => Math.round(statSync(path.resolve('src/documents', document.source)).size / 1024);
const c = ko ? {
  title: 'CV & Resume', description: '전상언의 1쪽 CV와 상세 이력서입니다. 각 문서의 기준 날짜를 함께 표시합니다.',
  eyebrow: '학력과 경험', intro: '학력, 연구, 프로젝트 경험을 담은 요약 문서와 상세 이력서입니다. 각 문서에 버전 기준 날짜를 표시했습니다.',
  shortLabel: '간략한 소개', shortTitle: 'One-page CV', shortDescription: '학력, 연구, 주요 프로젝트와 기술을 요약한 문서 중 가장 최근 버전입니다.',
  shortDownload: 'CV 다운로드', shortDate: '2026년 4월', shortPages: '1쪽',
  fullLabel: '상세 기록', fullTitle: 'Full resume', fullDescription: '연구, 프로젝트, 교육과 수업 이력을 더 자세히 담은 2025년 9월 기준 문서입니다.',
  fullDownload: 'Resume 다운로드', fullDate: '2025년 9월', fullPages: '3쪽',
} : {
  title: 'CV & resume', description: "Download Sangeon Jeon's one-page CV and comprehensive resume, with document version dates.",
  eyebrow: 'Background & experience', intro: 'A concise overview and a longer record of my education, research, and engineering experience. Each document is labeled with its version date.',
  shortLabel: 'Concise overview', shortTitle: 'One-page CV', shortDescription: 'The most recent available overview of my education, research, selected engineering work, and skills.',
  shortDownload: 'Download CV', shortDate: 'April 2026', shortPages: '1 page',
  fullLabel: 'Comprehensive record', fullTitle: 'Full resume', fullDescription: 'A more detailed record of research, projects, teaching, and coursework, reflecting the September 2025 version.',
  fullDownload: 'Download resume', fullDate: 'September 2025', fullPages: '3 pages',
};
---
<SiteLayout title={c.title} description={c.description} lang={lang}>
  <PageHeader title={c.title} eyebrow={c.eyebrow} description={c.intro} />
  <div class="document-grid">
    <article class="document-card"><div class="document-icon"><Icon name="book" size={30} /></div><p class="eyebrow">{c.shortLabel}</p><h2>{c.shortTitle}</h2><p>{c.shortDescription}</p><a class="button button-primary" href={`/documents/${shortDocument.filename}`} download>{c.shortDownload}<Icon name="download" size={16} /></a><div class="document-meta"><span>{c.shortDate}</span><span>{c.shortPages}</span><span>{ko ? '영문 PDF' : 'PDF'} · {sizeKB(shortDocument)} KB</span></div></article>
    <article class="document-card"><div class="document-icon"><Icon name="book" size={30} /></div><p class="eyebrow">{c.fullLabel}</p><h2>{c.fullTitle}</h2><p>{c.fullDescription}</p><a class="button" href={`/documents/${fullDocument.filename}`} download>{c.fullDownload}<Icon name="download" size={16} /></a><div class="document-meta"><span>{c.fullDate}</span><span>{c.fullPages}</span><span>{ko ? '영문 PDF' : 'PDF'} · {sizeKB(fullDocument)} KB</span></div></article>
  </div>
  <p class="page-note">{ko ? <>현재 연구 소개와 논문 진행 상황은 <a href={localizePath('/research/', lang)}>연구</a>와 <a href={localizePath('/publications/', lang)}>논문</a>에서 확인할 수 있습니다.</> : <>For current research descriptions and manuscript status, see <a href={localizePath('/research/', lang)}>Research</a> and <a href={localizePath('/publications/', lang)}>Publications</a>.</>}</p>
</SiteLayout>
