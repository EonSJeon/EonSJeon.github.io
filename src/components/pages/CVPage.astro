---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProfileLinks from '../ProfileLinks.astro';
import PublicationCitation from '../PublicationCitation.astro';
import { type Locale, getSiteCopy, getEducationCopy } from '../../lib/i18n';
import { getPublicEntries, hrefForEntry } from '../../lib/content';
import { getCVCopy } from '../../data/cv';
interface Props { lang?: Locale; }
const { lang = 'en' } = Astro.props;
const ko = lang === 'ko';
const site = getSiteCopy(lang);
const education = getEducationCopy(lang);
const records = getCVCopy(lang);
const [papers, projects] = await Promise.all([
  getPublicEntries('publications', lang),
  getPublicEntries('projects', lang),
]);
const engineering = projects;
// 번역 금지: 논문 제목·저자명·학회/저널 고유명은 영문 원문을 유지한다. 분류와 상태만 현지화한다.
const publicationGroups = [
  { type: 'conference', title: ko ? '[학회]' : '[Conference]' },
  { type: 'journal', title: ko ? '[저널]' : '[Journal]' },
];
// 번역 금지: CV & Resume 페이지 표기는 한국어에서도 그대로 유지한다.
const c = ko ? {
  title: 'CV & Resume', description: '전상언의 학력, 출판 및 연구·근무·교육 경험과 수상 이력입니다.',
  role: '전기·컴퓨터공학 박사과정', education: '학력', interests: '연구 관심 분야',
  publications: '출판', research: '연구 경험',
  employment: '근무 경험', teaching: '교육·지도', awards: '수상', projects: '주요 프로젝트',
  skills: '기술 및 언어', contents: 'CV 목차', earlier: '이전 연구', gpa: '학점',
} : {
  title: 'CV & Resume', description: 'Sangeon Jeon’s education, publications, research, employment, teaching, awards, and skills.',
  role: 'Ph.D. student, Electrical & Computer Engineering', education: 'Education', interests: 'Research interests',
  publications: 'Publications', research: 'Research experience',
  employment: 'Employment', teaching: 'Teaching & mentoring', awards: 'Awards', projects: 'Selected engineering',
  skills: 'Skills & languages', contents: 'CV contents', earlier: 'Earlier research', gpa: 'GPA',
};
const sections = [
  ['education', c.education], ['publications', c.publications], ['research', c.research],
  ['employment', c.employment], ['teaching', c.teaching], ['awards', c.awards],
  ['projects', c.projects], ['skills', c.skills],
];
const recordSections = [
  { id: 'employment', label: c.employment, entries: records.employment },
  { id: 'teaching', label: c.teaching, entries: records.teaching },
  { id: 'awards', label: c.awards, entries: records.awards },
];
---
<SiteLayout title={c.title} description={c.description} lang={lang}>
  <header class="cv-heading">
    <p class="eyebrow">{c.title}</p><h1>{site.name}</h1>
    <p class="cv-names">{ko ? 'Sangeon Jeon' : site.koreanName} <span lang="zh-Hant">· {site.hanjaName}</span></p>
    <p class="cv-role">{c.role}<br />Georgia Institute of Technology · Atlanta, Georgia</p>
    <ProfileLinks lang={lang} />
  </header>
  <div class="cv-layout">
    <nav class="cv-contents" aria-label={c.contents}><ul>{sections.map(([id, label]) => <li><a href={`#cv-${id}`}>{label}</a></li>)}</ul></nav>
    <div class="cv-body">
      <section class="cv-section" id="cv-education" aria-labelledby="cv-education-heading">
        <h2 id="cv-education-heading">{c.education}</h2>
        {education.map((item) => <article class="cv-entry"><div class="cv-entry-heading"><h3>{item.degree}</h3><span class="cv-period">{item.cvPeriod[lang]}</span></div><p class="cv-organization">{item.institution}</p><p>{c.gpa}: {item.gpa}{item.note && <> · {item.note}</>}</p></article>)}
        <h3 class="cv-subheading">{c.interests}</h3><ul class="tags">{site.interests.map((interest) => <li>{interest}</li>)}</ul>
      </section>
      <section class="cv-section" id="cv-publications" aria-labelledby="cv-publications-heading">
        <h2 id="cv-publications-heading">{c.publications}</h2>
        {publicationGroups.map((group) => <div class="cv-publication-group">
          <h3 class="cv-subheading">{group.title}</h3>
          {papers.filter((entry) => entry.data.publicationType === group.type).map((entry) => <article class="cv-entry cv-paper"><h3><a href={hrefForEntry(entry)}>{entry.data.title}</a></h3><PublicationCitation entry={entry} linkAuthors={false} /></article>)}
        </div>)}
        <p class="publication-legend">† {ko ? '공동 제1저자' : 'Co-first author'} · ‡ {ko ? '동등 기여' : 'Equal contribution'}</p>
      </section>
      <section class="cv-section" id="cv-research" aria-labelledby="cv-research-heading">
        <h2 id="cv-research-heading">{c.research}</h2>
        {records.earlierResearch.map((entry) => <article class="cv-entry"><div class="cv-entry-heading"><h3>{entry.title}</h3><span class="cv-period">{entry.period}</span></div><p class="cv-organization">{entry.organization}</p><p>{entry.description}</p></article>)}
      </section>
      {recordSections.map((section) => <section class="cv-section" id={`cv-${section.id}`} aria-labelledby={`cv-${section.id}-heading`}><h2 id={`cv-${section.id}-heading`}>{section.label}</h2>{section.entries.map((entry) => <article class="cv-entry"><div class="cv-entry-heading"><h3>{entry.title}</h3><span class="cv-period">{entry.period}</span></div><p class="cv-organization">{entry.organization}</p>{entry.description && <p>{entry.description}</p>}</article>)}</section>)}
      <section class="cv-section" id="cv-projects" aria-labelledby="cv-projects-heading">
        <h2 id="cv-projects-heading">{c.projects}</h2>
        {engineering.map((entry) => <article class="cv-entry"><div class="cv-entry-heading"><h3><a href={hrefForEntry(entry)}>{entry.data.title}</a></h3>{entry.data.period && <span class="cv-period">{entry.data.period}</span>}</div>{entry.data.contribution && <p class="cv-organization">{entry.data.contribution}</p>}<p>{entry.data.summary}</p></article>)}
      </section>
      <section class="cv-section" id="cv-skills" aria-labelledby="cv-skills-heading">
        <h2 id="cv-skills-heading">{c.skills}</h2><dl class="cv-skills">{records.skills.map((group) => <div><dt>{group.label}</dt><dd><ul>{group.items.map((item) => <li>{item}</li>)}</ul></dd></div>)}</dl>
      </section>
    </div>
  </div>
</SiteLayout>
<style>
  .cv-heading { padding: 64px 0 42px; border-bottom: 1px solid var(--line); }
  .cv-heading h1 { margin-bottom: 12px; }
  .cv-names { font-size: 16px; color: var(--muted); margin-bottom: 20px; }
  .cv-role { font-size: 15px; color: var(--muted); line-height: 1.8; margin-bottom: 18px; }
  .cv-layout { display: grid; grid-template-columns: 155px minmax(0, 1fr); gap: 58px; align-items: start; padding-top: 42px; }
  .cv-contents { position: sticky; top: calc(var(--sticky-header-height) + 28px); }
  .cv-contents ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 13px; }
  .cv-contents a { font-size: 12px; color: var(--muted); text-decoration: none; }
  .cv-contents a:hover { color: var(--accent-strong); text-decoration: underline; }
  .cv-body { min-width: 0; }
  .cv-section { margin-bottom: 48px; scroll-margin-top: 28px; }
  .cv-section h2 { font-size: 27px; padding-bottom: 15px; margin-bottom: 24px; border-bottom: 1px solid var(--line); }
  .cv-entry { margin-bottom: 25px; }
  .cv-entry-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
  .cv-entry h3 { font-size: 17px; line-height: 1.5; letter-spacing: -.012em; margin-bottom: 5px; }
  .cv-entry h3 a { color: var(--text); text-decoration: none; }
  .cv-entry h3 a:hover { color: var(--accent-strong); text-decoration: underline; }
  .cv-entry p { font-size: 13px; color: var(--muted); line-height: 1.8; margin-bottom: 4px; }
  .cv-entry .cv-organization { color: var(--text); font-size: 12px; }
  .cv-period { flex-shrink: 0; font-size: 11px; color: var(--subtle); white-space: nowrap; }
  .cv-subheading { font-family: var(--sans); font-size: 12px; font-weight: 600; margin: 28px 0 18px; }
  .cv-paper { margin-bottom: 28px; }
  .cv-paper :global(.publication-citation) { font-size: 14px; }
  .cv-skills { margin: 0; }
  .cv-skills > div { margin-bottom: 22px; }
  .cv-skills dt { font-size: 13px; font-weight: 600; margin-bottom: 8px; }
  .cv-skills dd { margin: 0; }
  .cv-skills ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 7px 18px; font-size: 13px; color: var(--muted); }
  @media screen and (min-width: 741px) {
    .cv-heading .eyebrow { font-size: 12px; }
    .cv-names { font-size: 18px; }
    .cv-role { font-size: 17px; }
    .cv-heading :global(.profile-links a) { font-size: 14px; }
    .cv-contents a { font-size: 14px; }
    .cv-section h2 { font-size: 30px; }
    .cv-entry h3 { font-size: 20px; }
    .cv-entry p { font-size: 16px; }
    .cv-entry .cv-organization { font-size: 14px; }
    .cv-period { font-size: 13px; }
    .cv-subheading { font-size: 15px; }
    .cv-entry :global(.publication-citation) { font-size: 15px; }
    .publication-legend { font-size: 13px; }
    .cv-section .tags li { font-size: 12px; }
    .cv-skills dt, .cv-skills ul { font-size: 16px; }
  }
  @media (max-width: 960px) {
    .cv-layout { grid-template-columns: 130px minmax(0, 1fr); gap: 32px; }
    .cv-entry-heading { flex-wrap: wrap; gap: 0 14px; }
    .cv-period { margin-bottom: 5px; }
  }
  @media (max-width: 740px) {
    .cv-heading { padding: 42px 0 30px; }
    .cv-layout { display: block; padding-top: 25px; }
    .cv-contents { position: static; margin-bottom: 32px; padding-bottom: 22px; border-bottom: 1px solid var(--line); }
    .cv-contents ul { display: flex; flex-wrap: wrap; gap: 10px 18px; }
    .cv-entry-heading { display: block; }
    .cv-period { display: block; }
    .cv-section h2 { font-size: 24px; }
    .cv-entry h3 { font-size: 16px; overflow-wrap: anywhere; }
    .cv-section { margin-bottom: 38px; }
  }
  @media print {
    .cv-layout { display: block; }
    .cv-contents { display: none; }
    .cv-heading { padding-top: 0; }
    .cv-entry { break-inside: avoid; }
  }
</style>
