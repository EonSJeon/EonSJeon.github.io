---
import { getSiteCopy, type Locale } from '../../lib/i18n';
interface Props { target: string; lang?: Locale; }
const { target, lang = 'en' } = Astro.props;
const site = getSiteCopy(lang);
const title = lang === 'ko' ? '페이지로 이동' : 'Continue to the page';
const canonical = new URL(target, Astro.site);
canonical.hash = '';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <title>{title} — {site.name}</title>
    <script is:inline define:vars={{ target }}>
      const destination = new URL(target, window.location.origin);
      destination.search = window.location.search;
      if (!destination.hash) destination.hash = window.location.hash;
      window.location.replace(destination.href);
    </script>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
  </head>
  <body>
    <p><a href={target}>{title}</a></p>
  </body>
</html>
