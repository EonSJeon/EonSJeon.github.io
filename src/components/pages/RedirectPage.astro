---
import { getSiteCopy, type Locale } from '../../lib/i18n';
interface Props { target: string; lang?: Locale; }
const { target, lang = 'en' } = Astro.props;
const site = getSiteCopy(lang);
const title = lang === 'ko' ? '페이지로 이동' : 'Continue to the page';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <title>{title} — {site.name}</title>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target + window.location.search + window.location.hash);
    </script>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
  </head>
  <body>
    <p><a href={target}>{title}</a></p>
  </body>
</html>
