---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import ProfileLinks from '../components/ProfileLinks.astro';
import { site, education } from '../data/site';
---
<SiteLayout title="About" description="About Sangeon Jeon, a Ph.D. student in Electrical and Computer Engineering at Georgia Tech.">
  <PageHeader title="About me" eyebrow="Sangeon Jeon · 전상언" />
  <div class="about-grid">
    <div>
      <div class="prose">
        <p>I am a Ph.D. student in Electrical and Computer Engineering at the Georgia Institute of Technology, advised by <a href={site.advisor.url}>Xiaoli Ma</a>.</p>
        <p>My research focuses on synchronization and statistical signal estimation for wireless communication systems. My current work considers frequency-offset estimation for chirp-based multicarrier waveforms and joint channel and hardware-impairment estimation in OFDM receivers.</p>
        <p>Alongside research, I enjoy building systems that connect mathematical models, software, and physical hardware. My engineering work has ranged from RFID-based reminders to bioelectrical recording and mechatronic prototypes.</p>
      </div>
      <section class="about-section" aria-labelledby="education-heading"><h2 id="education-heading">Education</h2><ul class="education-list">{education.map((item) => <li><div><strong>{item.degree}</strong><p>{item.institution}</p><p>GPA: {item.gpa}</p>{item.note && <p>{item.note}</p>}</div><time>{item.period}</time></li>)}</ul></section>
      <section class="about-section" aria-labelledby="interests-heading"><h2 id="interests-heading">Research interests</h2><ul class="tags">{site.interests.map((interest) => <li>{interest}</li>)}</ul></section>
      <section class="about-section" id="contact" aria-labelledby="contact-heading">
        <h2 id="contact-heading">Contact</h2>
        <div class="prose"><p>I am based in Atlanta, Georgia. For questions about my research or projects, email <a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a>.</p></div>
        <div class="contact-actions"><a class="button" href={`mailto:${site.email}`}><Icon name="mail" size={17} />Write an email</a><button class="button" type="button" data-copy-email={site.email}><Icon name="copy" size={17} />Copy email</button><a class="text-link" href="/cv/">CV & resume<Icon name="arrow-right" size={16} /></a></div>
        <p class="copy-status" role="status" aria-live="polite"></p>
        <ProfileLinks />
      </section>
    </div>
    <aside class="about-aside"><div class="about-photo"><img src="/images/sangeon-jeon.jpeg" alt="Sangeon Jeon" width="246" height="246" /></div><p class="about-caption">Georgia Institute of Technology<br />Electrical & Computer Engineering<br />Atlanta, Georgia</p></aside>
  </div>
</SiteLayout>
<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const copyStatus = document.querySelector<HTMLElement>('.copy-status');
  copyButton?.addEventListener('click', async () => {
    const email = copyButton.dataset.copyEmail;
    if (!email || !copyStatus) return;
    try {
      await navigator.clipboard.writeText(email);
      copyStatus.textContent = 'Email address copied.';
    } catch {
      const address = document.querySelector('.contact-email');
      if (address) {
        const range = document.createRange();
        range.selectNodeContents(address);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
      copyStatus.textContent = 'Select and copy the email address above.';
    }
  });
</script>
