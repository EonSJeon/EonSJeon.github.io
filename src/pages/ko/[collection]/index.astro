---
import CollectionPage from '../../../components/pages/CollectionPage.astro';
import { isPrivatePreview } from '../../../lib/content-policy.mjs';
import { getPublicEntries, getBlogEntries } from '../../../lib/content';
export async function getStaticPaths() {
  if (!isPrivatePreview()) return [];
  return [
    { params: { collection: 'coursework' }, props: { collection: 'coursework' as const, entries: await getPublicEntries('coursework', 'ko') } },
    { params: { collection: 'blog' }, props: { collection: 'blog' as const, entries: await getBlogEntries('ko') } },
  ];
}
const { collection, entries } = Astro.props;
---
<CollectionPage collection={collection} entries={entries} lang="ko" />
