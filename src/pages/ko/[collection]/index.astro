---
import CollectionPage from '../../../components/pages/CollectionPage.astro';
import RedirectPage from '../../../components/pages/RedirectPage.astro';
import { legacyRedirects } from '../../../lib/redirects';
import { PUBLIC_COLLECTIONS, getPublicEntries } from '../../../lib/content';
export async function getStaticPaths() {
  return [
    ...await Promise.all(PUBLIC_COLLECTIONS.map(async (collection) => ({ params: { collection }, props: { collection, entries: await getPublicEntries(collection, 'ko'), redirectTo: undefined } }))),
    { params: { collection: 'research' }, props: { collection: undefined, entries: [], redirectTo: legacyRedirects['/ko/research/'] } },
  ];
}
const { collection, entries, redirectTo } = Astro.props;
---
{collection ? <CollectionPage collection={collection} entries={entries} lang="ko" /> : <RedirectPage target={redirectTo!} lang="ko" />}
