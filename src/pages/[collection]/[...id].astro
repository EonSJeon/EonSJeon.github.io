---
import EntryPage from '../../components/pages/EntryPage.astro';
import { getPublicEntries, getBlogEntries, slugForEntry } from '../../lib/content';
export async function getStaticPaths() {
  const [projects, courses, writing] = await Promise.all([
    getPublicEntries('projects', 'en'), getPublicEntries('coursework', 'en'), getBlogEntries('en'),
  ]);
  return [...projects, ...courses, ...writing].map((entry) => ({
    params: { collection: entry.collection === 'proposals' ? 'blog' : entry.collection, id: `${entry.collection === 'proposals' ? 'ideas/' : ''}${slugForEntry(entry)}` },
    props: { entry },
  }));
}
const { entry } = Astro.props;
---
<EntryPage entry={entry} />
