---
import CollectionPage from '../../components/pages/CollectionPage.astro';
import { getPublicEntries, getBlogEntries } from '../../lib/content';
export async function getStaticPaths() {
  return [
    { params: { collection: 'coursework' }, props: { collection: 'coursework' as const, entries: await getPublicEntries('coursework', 'en') } },
    { params: { collection: 'blog' }, props: { collection: 'blog' as const, entries: await getBlogEntries('en') } },
  ];
}
const { collection, entries } = Astro.props;
---
<CollectionPage collection={collection} entries={entries} lang="en" />
