---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WorkCard from '../components/WorkCard.astro';
import TokenDiagram from '../components/TokenDiagram.astro';
import ProfileLinks from '../components/ProfileLinks.astro';
import { site } from '../data/site';
import { getPublicEntries, hrefForEntry } from '../lib/content';
const [research, projects, coursework, writing, proposals] = await Promise.all([
  getPublicEntries('research'), getPublicEntries('projects'), getPublicEntries('coursework'), getPublicEntries('blog'), getPublicEntries('proposals'),
]);
const selectedResearch = research.filter((entry) => entry.data.featured).slice(0, 2);
const selectedCoursework = coursework.filter((entry) => entry.data.featured).slice(0, 2);
const project = projects.find((entry) => entry.data.featured);
---
<SiteLayout>
  <section class="hero" aria-labelledby="intro-title">
    <div class="hero-text">
      <p class="eyebrow">Georgia Tech · Electrical & Computer Engineering</p>
      <h1 id="intro-title">Sangeon Jeon<span class="hero-korean" lang="ko">전상언</span></h1>
      <p class="hero-role">Ph.D. student · Atlanta, Georgia</p>
      <p class="hero-description">I study synchronization and statistical signal estimation for wireless communication systems. I am a Ph.D. student at Georgia Tech, advised by <a href={site.advisor.url}>Xiaoli Ma</a>.</p>
      <ProfileLinks />
      <a class="text-link hero-about" href="/about/">More about me<Icon name="arrow-right" size={16} /></a>
    </div>
    <figure class="hero-portrait"><div class="portrait-frame"><img src="/images/sangeon-jeon.jpeg" alt="Sangeon Jeon" width="246" height="246" fetchpriority="high" /></div><figcaption>Georgia Institute of Technology</figcaption></figure>
  </section>
  <div class="interest-line"><span>Research interests</span><ul>{site.interests.map((interest) => <li>{interest}</li>)}</ul></div>
  <section class="home-section" aria-labelledby="research-heading">
    <SectionHeading title="Selected research" label="Wireless communications & signal processing" href="/research/" linkText="All research" id="research-heading" />
    <div class="work-grid">{selectedResearch.map((entry) => <WorkCard entry={entry} />)}</div>
  </section>
  {project && <section class="home-section" aria-label="Selected independent project">
    <SectionHeading title="Outside the lab" label="Independent engineering" href="/projects/" linkText="All projects" />
    <article class="project-feature">
      <TokenDiagram compact />
      <div class="feature-copy"><p class="eyebrow">2024 KAIST Makerathon · Grand Prize</p><h3>When to Eat</h3><p class="feature-subtitle">RFID Food Storage Reminder</p><p class="feature-description">A food-storage reminder that connects reusable RFID tokens with a desktop interface. A team-built prototype, designed around everyday physical interactions.</p><a class="text-link" href={hrefForEntry(project)}>Explore the project<Icon name="arrow-right" size={17} /></a></div>
    </article>
  </section>}
  <section class="home-section" aria-label="Selected coursework">
    <SectionHeading title="Learning through making" label="Selected coursework" href="/coursework/" linkText="All coursework" />
    <div class="work-grid">{selectedCoursework.map((entry) => <WorkCard entry={entry} compact />)}</div>
  </section>
  {(writing.length > 0 || proposals.length > 0) && <section class="home-section" aria-label="Recent writing and ideas">
    <SectionHeading title="Writing & ideas" />
    <div class="editorial-list">{[...writing, ...proposals].slice(0, 3).map((entry) => <article class="editorial-entry"><p class="eyebrow">{entry.data.categoryLabel}</p><h3><a href={hrefForEntry(entry)}>{entry.data.title}</a></h3><p>{entry.data.summary}</p></article>)}</div>
  </section>}
  <div class="home-contact"><p>Interested in my research or engineering work?</p><a class="text-link" href="/about/#contact">Get in touch<Icon name="arrow-right" size={16} /></a></div>
</SiteLayout>
