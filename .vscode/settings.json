{
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode",
    "editor.wordWrap": "on"
  },
  "[markdown]": {
    "editor.wordWrap": "on"
  },
  "latex-workshop.latex.autoBuild.run": "never",
  "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/CV-Resume/build",
  "latex-workshop.latex.recipes": [
    {
      "name": "Build all CV/Resume documents (Tectonic)",
      "tools": [
        "cv-documents"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "cv-documents",
      "command": "/bin/sh",
      "args": [
        "%WORKSPACE_FOLDER%/CV-Resume/build.sh"
      ]
    }
  ],
  "latex-workshop.view.pdf.viewer": "tab"
}
